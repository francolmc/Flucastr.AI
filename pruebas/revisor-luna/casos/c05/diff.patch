@@ -0,0 +1,7 @@
+export async function listarPorEstado(repo, estado, pagina) {
+  const desde = (pagina - 1) * 20;
+  const todos = await repo.todos();
+  return todos.filter((p) => p.estado === estado).slice(desde, desde + 20);
+}
