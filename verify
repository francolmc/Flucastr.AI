#!/usr/bin/env bash
# verify: comprueba que la v2 del kit está coherente. Sin Docker, sin escribir fuera del repo.
set -euo pipefail
cd "$(dirname "$0")"
# Los pasos instalan en HOME temporales: CODEX_HOME (si la sesión la define) apuntaría al ~/.codex real.
unset CODEX_HOME

fallo() { echo "FALLO: $*" >&2; exit 1; }
paso() {
  if [ -n "${VERIFY_FASE_ARCHIVO:-}" ]; then printf '%s' "$1" > "$VERIFY_FASE_ARCHIVO"; fi
  echo "== $1. $2 =="
}

command -v node >/dev/null 2>&1 || fallo "falta node en el PATH"

# Dueño del temporal de la corrida, de sus traps y del registro de verificación ya hecha (scripts/kit-verificado.mjs):
# tools/verify/envoltorio.sh corre este mismo archivo como cuerpo, con VERIFY_HIJO=1. Los scripts sourced fijan sus
# propios trap EXIT dentro del cuerpo, que es un proceso hijo; el envoltorio no depende de ellos.
if [ -z "${VERIFY_HIJO:-}" ]; then
  exec bash tools/verify/envoltorio.sh "$PWD/verify" "$@"
fi

source tools/verify/snapshot.sh

source tools/verify/models.sh

source tools/verify/install-help.sh

source tools/verify/agent-resolution.sh

source tools/verify/skills.sh

source tools/verify/install-simulation.sh

source tools/verify/project-permissions.sh

source tools/verify/migration.sh

source tools/verify/workspace-contracts.sh

source tools/verify/operating-contract.sh

source tools/verify/workflow-contract.sh

source tools/verify/launchers.sh

source tools/verify/codex-launcher.sh

source tools/verify/codex-negative.sh
source tools/verify/agent-contracts.sh
source tools/verify/verification-contracts.sh

# 9a. migración: la skill migrar-proyecto muestra «Reglas de v1 que descarté», prohíbe copiar las reglas de flujo y no trae Fxx como regla; una copia sin la lista debe fallar
source tools/verify/migration-contract.sh

source tools/verify/names-migration.sh

source tools/verify/offline-selftests.sh

source tools/verify/segment-contract.sh

source tools/verify/usage-and-run.sh

source tools/verify/docker-observer.sh

source tools/verify/small-change-contract.sh

# 20. verificación ya hecha: la utilidad compara huella y nivel, y la huella cubre archivos sin seguimiento (tests/ya-verificado)
paso 20 "verificación ya hecha: scripts/kit-verificado.mjs y su huella (tests/ya-verificado)"
node --test tests/ya-verificado/ya-verificado.test.mjs || fallo "20: pruebas de la verificación ya hecha no pasaron"

# 21. builder pegado en kit run: detector puro y casos de integración (changes/kit-run-pegado, segmento 3)
paso 21 "builder pegado en kit run: detector y casos D1–D5 (tests/kit-run/pegado.test.mjs)"
node --test tests/kit-run/pegado.test.mjs || fallo "21: pruebas del builder pegado no pasaron"

# 22. pruebas de compactación por agente: ventana, lanzadores, Codex, Pi y comprobación de ventanas (changes/ventana-por-agente, historia A)
paso 22 "pruebas de compactación por agente: tests/compaction/*.test.mjs (ventanas incluidas)"
node --test tests/compaction/*.test.mjs || fallo "22: pruebas de compactación no pasaron"

# 23. piso de contexto y hook tras compactar: tamaños de SKILL.md, planner.md y AGENTS.md; punteros e instalación del hook (changes/piso-planner, historia D)
paso 23 "piso de contexto y hook tras compactar: tests/context-size/*.test.mjs y tests/after-compact/*.test.mjs"
node --test tests/context-size/*.test.mjs tests/after-compact/*.test.mjs || fallo "23: pruebas de tamaños y del hook tras compactar no pasaron"

# 24. temporales: barrido de viejos, temporal único por corrida y espacio libre (changes/higiene-verify, historia «verify limpio y breve»)
paso 24 "temporales: tests/temporales/*.test.mjs (barrido, envoltorio, espacio libre)"
node --test tests/temporales/*.test.mjs || fallo "24: pruebas de temporales no pasaron"

# 25. hook de permisos: analizador de shell, decisión y conexión en vivo (changes/hook-parser, segmento 3)
paso 25 "hook de permisos: tests/permissions-contract/hook*.test.mjs (analizador, decisión y conexión)"
node --test tests/permissions-contract/hook.test.mjs tests/permissions-contract/hook-shell.test.mjs tests/permissions-contract/hook-decision.test.mjs || fallo "25: pruebas del hook de permisos no pasaron"

# 26. banco del builder: calibración, variantes, corrida, métricas y comparación sin Codex ni red (changes/evals-builder, tramo 10)
paso 26 "banco del builder: tests/evals-builder/*.test.mjs"
node --test tests/evals-builder/*.test.mjs || fallo "26: pruebas del banco del builder no pasaron"

echo "VERIFY OK"
